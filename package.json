{
  "name": "@solwyn/sdk",
  "version": "0.1.0-rc.1",
  "description": "Usage metadata and budget controls for OpenAI, Anthropic, Google, Bedrock, compatible clients, and AI SDK; failover for wrapped provider clients.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solwyn-ai/solwyn-typescript-sdk.git"
  },
  "homepage": "https://solwyn.ai",
  "bugs": {
    "url": "https://github.com/solwyn-ai/solwyn-typescript-sdk/issues"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "bedrock",
    "budgets",
    "token-usage",
    "cost-tracking",
    "failover"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk/index.d.ts",
        "default": "./dist/ai-sdk/index.js"
      },
      "require": {
        "types": "./dist/ai-sdk/index.d.cts",
        "default": "./dist/ai-sdk/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/node.js",
    "./dist/node.cjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "check:public": "node scripts/check-public-surface.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:consumers": "node scripts/verification/run.mjs",
    "surfaces:capture": "tsx scripts/capture-surface-inventory.ts --interval latest --update",
    "surfaces:check": "tsx scripts/capture-surface-inventory.ts --interval latest --check",
    "surfaces:diff": "tsx scripts/diff-surface-baseline.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0 <1",
    "@aws-sdk/client-bedrock-runtime": ">=3.422.0 <4",
    "@google/genai": ">=0.3.1 <3",
    "ai": ">=7.0.14 <8",
    "openai": ">=4.41.0 <7",
    "together-ai": ">=0.16.0 <1"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "together-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@aws-sdk/client-bedrock-runtime": "3.1124.0",
    "@biomejs/biome": "^2.5.2",
    "@google/genai": "2.20.0",
    "@google/generative-ai": "0.24.1",
    "@types/json-schema": "7.0.15",
    "@types/node": "^26.1.0",
    "ai": "7.0.14",
    "esbuild": "0.27.7",
    "openai": "6.45.0",
    "together-ai": "0.50.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  }
}
